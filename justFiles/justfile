hello:
	@echo "hello world!"


init:
	mkdir ../repoGit
	git clone git@github.com:YounesFikri/devOpsM.git ../repoGit

status:
	git status 


add:
	git add .

commit:
	@read -p "Enter a message: " message; \
	git commit -m "$message"

log:
	@git log --graph --oneline 

supprimer:
	rm -f ../tmp.txt




create-db:
	@sudo -u postgres createuser --if-not-exists -s $USER; \
	createdb ma_base; \

db-query *args:
    psql -d ma_base -c "{{args}}"


db-reset: 
	dropdb --if-exists -f ma_base
   
